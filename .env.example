# Copy to .env.local and fill only the values needed for local development.
# Keep real credentials in .env.local or your deployment secret store.

# Canonical site origin (for example, https://your-verified-domain.example)
SITE_URL=

# Shopify Storefront API (server-only)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=

# Contact delivery (server-only; provider not selected yet)
CONTACT_PROVIDER_API_KEY=
CONTACT_TO_EMAIL=

# Shared rate-limit store (server-only; provider not selected yet)
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# Optional analytics and Search Console configuration
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
